		if sideName == "BLUE" then
			sideBtn.BackgroundColor3 = Color3.fromRGB(25, 95, 220)
			sideBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		else
			sideBtn.BackgroundColor3 = Color3.fromRGB(210, 45, 55)
			sideBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		end
		sideBtn.Parent = row

		local sCorner = Instance.new("UICorner")
		sCorner.CornerRadius = UDim.new(0, 3)
		sCorner.Parent = sideBtn

		local isNo = playerExcludedNo[targetPlr.UserId] == true
		local noBtn = Instance.new("TextButton")
		noBtn.Size = UDim2.new(0, 31, 0, 13)
		noBtn.Position = UDim2.new(1, -33, 0.5, -6.5)
		noBtn.BorderSizePixel = 0
		noBtn.Font = Enum.Font.Code
		noBtn.TextSize = 8
		noBtn.Text = isNo and "NO" or "OK"
		noBtn.BackgroundColor3 = isNo and Color3.fromRGB(140, 30, 30) or Color3.fromRGB(35, 90, 45)
		noBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
		noBtn.Parent = row

		local nCorner = Instance.new("UICorner")
		nCorner.CornerRadius = UDim.new(0, 3)
		nCorner.Parent = noBtn

		return sideBtn, noBtn
	end

	local function refreshTeamList()
		for _, child in ipairs(listScroll:GetChildren()) do
			if child:IsA("Frame") or child:IsA("TextLabel") then
				child:Destroy()
			end
		end

		local allPlayers = Players:GetPlayers()
		local blueList = {}
		local redList = {}

		for i, p in ipairs(allPlayers) do
			if not playerManualSide[p.UserId] then
				playerManualSide[p.UserId] = (i <= 4) and "BLUE" or "RED"
			end
			if playerManualSide[p.UserId] == "BLUE" then
				table.insert(blueList, p)
			else
				table.insert(redList, p)
			end
		end

		local orderCounter = 1
		createGroupHeader("BLUE", Color3.fromRGB(90, 175, 255), orderCounter)
		orderCounter = orderCounter + 1

		for _, p in ipairs(blueList) do
			local sideBtn, noBtn = createPlayerEntry(p, "BLUE", orderCounter)
			orderCounter = orderCounter + 1

			sideBtn.MouseButton1Click:Connect(function()
				playerManualSide[p.UserId] = "RED"
				refreshTeamList()
			end)

			noBtn.MouseButton1Click:Connect(function()
				playerExcludedNo[p.UserId] = not playerExcludedNo[p.UserId]
				refreshTeamList()
			end)
		end

		createGroupHeader("RED", Color3.fromRGB(255, 95, 105), orderCounter)
		orderCounter = orderCounter + 1

		for _, p in ipairs(redList) do
			local sideBtn, noBtn = createPlayerEntry(p, "RED", orderCounter)
			orderCounter = orderCounter + 1

			sideBtn.MouseButton1Click:Connect(function()
				playerManualSide[p.UserId] = "BLUE"
				refreshTeamList()
			end)

			noBtn.MouseButton1Click:Connect(function()
				playerExcludedNo[p.UserId] = not playerExcludedNo[p.UserId]
				refreshTeamList()
			end)
		end

		task.defer(function()
			listScroll.CanvasSize = UDim2.new(0, 0, 0, layout.AbsoluteContentSize.Y + 6)
		end)
	end

	refreshTeamList()
	Players.PlayerAdded:Connect(refreshTeamList)
	Players.PlayerRemoving:Connect(function(leftPlr)
		playerManualSide[leftPlr.UserId] = nil
		playerExcludedNo[leftPlr.UserId] = nil
		refreshTeamList()
	end)

	local teamMinimized = false
	teamToggleBtn.MouseButton1Click:Connect(function()
		teamMinimized = not teamMinimized
		teamBody.Visible = not teamMinimized
		if teamMinimized then
			teamPanel.Size = UDim2.new(0, 184, 0, 24)
			teamToggleBtn.Text = "SHOW"
		else
			teamPanel.Size = UDim2.new(0, 184, 0, 136)
			teamToggleBtn.Text = "HIDE"
		end
	end)

	local lastUpdate = 0
	local frameCount = 0
	local currentFps = 60

	-- ===== SEGUIMIENTO VISUAL AL TORSO DE ENEMIGOS =====
	local raycastParams = RaycastParams.new()
	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	local throttle = 0
	local lockedTargetTorso = nil
	local torsoYOffset = -8

	RunService.RenderStepped:Connect(function(dt)
		frameCount = frameCount + 1
		lastUpdate = lastUpdate + dt
		if lastUpdate >= 0.5 then
			currentFps = math.floor(frameCount / lastUpdate + 0.5)
			frameCount = 0
			lastUpdate = 0
		end

		local pingVal = 0
		pcall(function()
			pingVal = math.floor(player:GetNetworkPing() * 1000)
		end)

		lblFps.Text = string.format("FPS.........: %d", currentFps)
		lblPhysics.Text = string.format("Physics.....: %.1f / %.1f msec", dt * 1000, 16.6)
		lblRender.Text = string.format("Render......: %.1f / %.1f msec", dt * 1000, 16.6)
		lblNetwork.Text = string.format("Network receive: %d ms ping", pingVal)

		local currentCam = Workspace.CurrentCamera
		camera = currentCam

		local myChar = player.Character
		if not myChar or not camera then
			lockedTargetTorso = nil
			return
		end

		local myHumanoid = myChar:FindFirstChildOfClass("Humanoid")
		if not myHumanoid or myHumanoid.Health <= 0 then
			lockedTargetTorso = nil
			return
		end

		local hasWeapon = myChar:FindFirstChildOfClass("Tool") ~= nil

		if hasWeapon then
			throttle = throttle + dt
			if throttle >= 0.03 then
				throttle = 0

				local bestTarget = nil
				local shortestDistance = 220
				local centerScreen = Vector2.new(camera.ViewportSize.X * 0.5, camera.ViewportSize.Y * 0.5)

				raycastParams.FilterDescendantsInstances = {myChar}

				if lockedTargetTorso and lockedTargetTorso.Parent then
					local enemyChar = lockedTargetTorso.Parent
					local enemyPlayer = Players:GetPlayerFromCharacter(enemyChar)
					local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")

					if enemyPlayer and isEnemy(enemyPlayer) and humanoid and humanoid.Health > 0 then
						local screenPoint, onScreen = camera:WorldToViewportPoint(lockedTargetTorso.Position)
						if onScreen and screenPoint.Z > 0 then
							local origin = camera.CFrame.Position
							local direction = lockedTargetTorso.Position - origin
							local rayResult = Workspace:Raycast(origin, direction, raycastParams)
							if rayResult and rayResult.Instance:IsDescendantOf(enemyChar) then
								bestTarget = lockedTargetTorso
							end
						end
					end
				end

				if not bestTarget then
					for _, otherPlayer in ipairs(Players:GetPlayers()) do
						if isEnemy(otherPlayer) then
							local enemyChar = otherPlayer.Character
							if enemyChar then
								local humanoid = enemyChar:FindFirstChildOfClass("Humanoid")
								local torso = enemyChar:FindFirstChild("UpperTorso") or enemyChar:FindFirstChild("Torso")

								if humanoid and humanoid.Health > 0 and torso then
									local screenPoint, onScreen = camera:WorldToViewportPoint(torso.Position)
									if onScreen and screenPoint.Z > 0 then
										local dist = (Vector2.new(screenPoint.X, screenPoint.Y) - centerScreen).Magnitude
										if dist < shortestDistance then
											local origin = camera.CFrame.Position
											local direction = torso.Position - origin
											local rayResult = Workspace:Raycast(origin, direction, raycastParams)

											if rayResult and rayResult.Instance:IsDescendantOf(enemyChar) then
												shortestDistance = dist
												bestTarget = torso
											end
										end
									end
								end
							end
						end
					end
				end

				lockedTargetTorso = bestTarget
			end

			if lockedTargetTorso and lockedTargetTorso.Parent then
				local screenPoint, onScreen = camera:WorldToViewportPoint(lockedTargetTorso.Position)
				if onScreen and screenPoint.Z > 0 then
					local targetPos = UDim2.new(0, screenPoint.X, 0, screenPoint.Y + torsoYOffset)
					crosshairContainer.Position = crosshairContainer.Position:Lerp(targetPos, 0.55)
				end
			end
		else
			lockedTargetTorso = nil
		end
	end)

	-- Detección de armas en el personaje
	local function monitorCharacter(char)
		local function checkWeapon()
			local equipped = false
			for _, item in ipairs(char:GetChildren()) do
				if item:IsA("Tool") then
					equipped = true
					break
				end
			end
			setCrosshairStyle(equipped)
		end

		checkWeapon()

		char.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(checkWeapon)
			end
		end)

		char.ChildRemoved:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(checkWeapon)
			end
		end)
	end

	if player.Character then
		monitorCharacter(player.Character)
	end

	player.CharacterAdded:Connect(monitorCharacter)
end

