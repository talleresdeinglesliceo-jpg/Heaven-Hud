local function makePart(parent, size, pos, color, cornerScaleOrPx, zIndex, transp)
	local frame = Instance.new("Frame")
	frame.AnchorPoint = Vector2.new(0.5, 0.5)
	frame.Size = size
	frame.Position = pos
	frame.BackgroundColor3 = color
	frame.BackgroundTransparency = transp or 0
	frame.BorderSizePixel = 0
	frame.ZIndex = zIndex or 2
	frame.Parent = parent

	if cornerScaleOrPx then
		local corner = Instance.new("UICorner")
		if cornerScaleOrPx >= 50 then
			corner.CornerRadius = UDim.new(1, 0)
		else
			corner.CornerRadius = UDim.new(0, cornerScaleOrPx)
		end
		corner.Parent = frame
	end
	return frame
end

